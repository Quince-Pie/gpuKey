+static void vulkan_trim_idle_reconstructions(FFVulkanEncodeContext *ctx)
+{
+    /* Queue-owned images have no per-command frame reference. Empty output
+     * FIFO after successful readout proves completion of every issued encode.
+     * Fatal/partial submission failures must instead wait during full close. */
+    if (!ctx->queue_dpb || av_fifo_can_read(ctx->base.encode_fifo))
+        return;
+    int released = 0;
+    for (int slot = 0; slot < FF_ARRAY_ELEMS(ctx->queue_dpb_frames); slot++) {
+        if (ctx->slots[slot] || !ctx->queue_dpb_frames[slot])
+            continue;
+        ctx->s.vkfn.DestroyImageView(ctx->s.hwctx->act_dev, ctx->queue_dpb_views[slot],
+                                     ctx->s.hwctx->alloc);
+        ctx->queue_dpb_views[slot] = VK_NULL_HANDLE;
+        av_frame_free(&ctx->queue_dpb_frames[slot]);
+        released = 1;
+    }
+    if (released) {
+        AVHWFramesContext *frames = (AVHWFramesContext *)ctx->queue_dpb_context->data;
+        av_buffer_pool_trim(frames->pool, 0);
+    }
+}
