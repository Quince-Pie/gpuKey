 int ff_vulkan_encode_receive_packet(AVCodecContext *avctx, AVPacket *pkt)
 {
     FFVulkanEncodeContext *ctx = avctx->priv_data;
     int ret = ff_hw_base_encode_receive_packet(&ctx->base, avctx, pkt);
     if (ctx->opts.async_trim)
         av_buffer_pool_trim(ctx->buf_pool, ctx->opts.async_trim == 1);
+    if (ctx->opts.async_trim == 2 &&
+        (ret >= 0 || ret == AVERROR(EAGAIN) || ret == AVERROR_EOF))
+        vulkan_trim_idle_reconstructions(ctx);
     return ret;
 }
 
