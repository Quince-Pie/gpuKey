+/* One caller-owned packed OBU, using the same syntax/state writer as CBS.
+ * The VAAPI caller treats a write failure as terminal for the picture. */
+int ff_cbs_av1_write_obu_buffer(CodedBitstreamContext *ctx, AV1RawOBU *obu,
+                               uint8_t *data, size_t capacity, size_t *bits)
+{
+#if CBS_WRITE
+    CodedBitstreamUnit unit = { .type = obu->header.obu_type, .content = obu };
+    PutBitContext pbc;
+    int err;
+
+    /* The writer reserves up to two OBU-header and eight size-field bytes. */
+    if (capacity < 10 || capacity > INT_MAX / 8)
+        return AVERROR(ENOSPC);
+    if (((CodedBitstreamAV1Context *)ctx->priv_data)->omit_redundant_header_copy &&
+        unit.type == AV1_OBU_REDUNDANT_FRAME_HEADER)
+        return AVERROR(EINVAL);
+
+    /* A sequence survives this call in the syntax context. Make its ownership
+     * explicit before the writer takes pointers into it. Other raw OBUs are
+     * borrowed only for the call; retained frame-header bits are still copied. */
+    if (unit.type == AV1_OBU_SEQUENCE_HEADER) {
+        err = CBS_FUNC(make_unit_refcounted)(ctx, &unit);
+        if (err < 0)
+            return err;
+    }
+    init_put_bits(&pbc, data, capacity);
+    err = cbs_av1_write_obu(ctx, &unit, &pbc);
+    if (err >= 0) {
+        *bits = put_bits_count(&pbc);
+        flush_put_bits(&pbc);
+    }
+    av_refstruct_unref(&unit.content_ref);
+    return err;
+#else
+    return AVERROR(ENOSYS);
+#endif
+}
