+
+// Synchronous transfers borrow their caller's source/context lifetime. They
+// need plane views, not an owned AVFrame/HWMapDescriptor/reference graph.
+// Frame references/properties remain intact on failure. Device backing is not
+// transactional: a failed operation may already have modified its destination.
+static int vaapi_copy_pixels(uint8_t *const dst[4], const int dst_stride[4],
+                             uint8_t *const src[4], const int src_stride[4],
+                             enum AVPixelFormat format, int width, int height)
+{
+    int planes = av_pix_fmt_count_planes(format);
+    if (width <= 0 || height <= 0 || planes <= 0)
+        return AVERROR(EINVAL);
+    for (int i = 0; i < planes; ++i)
+        if (!dst[i] || !src[i])
+            return AVERROR(EINVAL);
+    av_image_copy2(dst, dst_stride, src, src_stride, format, width, height);
+    return 0;
 }
 
