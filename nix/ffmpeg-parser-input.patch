--- a/libavcodec/avcodec.h
+++ b/libavcodec/avcodec.h
@@ -2623,6 +2623,11 @@
 
     int flags;
 #define PARSER_FLAG_COMPLETE_FRAMES           0x0001
+/** AV1 one-shot validation may reference complete, padded input instead of
+ * copying it. The caller must retain every input buffer, immutable and with
+ * AV_INPUT_BUFFER_PADDING_SIZE zero bytes, until av_parser_close(). Other
+ * parsers may ignore this optimization. */
+#define PARSER_FLAG_BORROWED_INPUT             0x2000
 #define PARSER_FLAG_ONCE                      0x0002
 /// Set if the parser has a valid file offset
 #define PARSER_FLAG_FETCHED_OFFSET            0x0004
--- a/libavcodec/av1_parser.c
+++ b/libavcodec/av1_parser.c
@@ -51,6 +51,13 @@
 static const enum AVPixelFormat pix_fmts_rgb[3] = {
     AV_PIX_FMT_GBRP, AV_PIX_FMT_GBRP10, AV_PIX_FMT_GBRP12,
 };
+
+static void borrowed_input_free(void *opaque, uint8_t *data)
+{
+    (void)opaque;
+    (void)data;
+    // The opted-in caller retains the padded input through parser close.
+}
 
 static int av1_parser_parse(AVCodecParserContext *ctx,
                             AVCodecContext *avctx,
@@ -84,7 +91,20 @@
         ff_cbs_fragment_reset(td);
     }
 
-    ret = ff_cbs_read(s->cbc, td, NULL, data, size);
+    if (size > 0 && (ctx->flags & PARSER_FLAG_COMPLETE_FRAMES) &&
+        (ctx->flags & PARSER_FLAG_BORROWED_INPUT)) {
+        AVBufferRef *input = av_buffer_create((uint8_t *)data, (size_t)size,
+                                               borrowed_input_free, NULL,
+                                               AV_BUFFER_FLAG_READONLY);
+        if (!input) {
+            ret = AVERROR(ENOMEM);
+            goto end;
+        }
+        ret = ff_cbs_read(s->cbc, td, input, data, size);
+        av_buffer_unref(&input);
+    } else {
+        ret = ff_cbs_read(s->cbc, td, NULL, data, size);
+    }
     if (ret < 0) {
