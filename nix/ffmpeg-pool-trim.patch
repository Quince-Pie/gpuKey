+size_t av_buffer_pool_trim(AVBufferPool *pool, size_t keep)
+{
+    BufferPoolEntry **link, *entry;
+    size_t released = 0;
+    if (!pool)
+        return 0;
+    ff_mutex_lock(&pool->mutex);
+    link = &pool->pool;
+    while (*link && keep) {
+        link = &(*link)->next;
+        --keep;
+    }
+    entry = *link;
+    *link = NULL;
+    if (entry)
+        atomic_fetch_add_explicit(&pool->refcount, 1, memory_order_relaxed);
+    ff_mutex_unlock(&pool->mutex);
+    if (!entry)
+        return 0;
+    do {
+        BufferPoolEntry *next = entry->next;
+        entry->free(entry->opaque, entry->data);
+        av_free(entry);
+        ++released;
+        entry = next;
+    } while (entry);
+    if (atomic_fetch_sub_explicit(&pool->refcount, 1, memory_order_acq_rel) == 1)
+        buffer_pool_free(pool);
+    return released;
+}
