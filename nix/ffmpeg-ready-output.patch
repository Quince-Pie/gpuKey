+static int vaapi_encode_ready(AVCodecContext *avctx, FFHWBaseEncodePicture *base_pic)
+{
+#if VA_CHECK_VERSION(1, 9, 0)
+    VAAPIEncodeContext *ctx = avctx->priv_data;
+    VAAPIEncodePicture *pic = base_pic->priv;
+    VAStatus status;
+
+    av_assert0(base_pic->encode_issued);
+    ctx->base.async_fd = ctx->async_events ? pic->output_buffer_ref->fd : -1;
+    if (base_pic->encode_complete)
+        return 1;
+    status = vaSyncBuffer(ctx->hwctx->display, pic->output_buffer, 0);
+    if (status == VA_STATUS_SUCCESS) {
+        // The same retirement as the blocking wait; output no longer needs
+        // another synchronization call after this successful completion query.
+        av_frame_free(&base_pic->input_image);
+        base_pic->encode_complete = 1;
+        return 1;
+    }
+    if (status == VA_STATUS_ERROR_TIMEDOUT)
+        return 0;
+    av_log(avctx, AV_LOG_ERROR, "Failed to query output buffer completion: %d (%s).\n",
+           status, vaErrorStr(status));
+    return AVERROR(EIO);
+#else
+    return AVERROR(ENOSYS);
+#endif
+}
