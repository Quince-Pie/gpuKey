+    case AV_PIX_FMT_BGR0: compatible = fourcc == DRM_FORMAT_XRGB8888; break;
+    case AV_PIX_FMT_RGBA: compatible = fourcc == DRM_FORMAT_ABGR8888; break;
+    case AV_PIX_FMT_RGB0: compatible = fourcc == DRM_FORMAT_XBGR8888; break;
+    case AV_PIX_FMT_X2RGB10:
+        compatible = fourcc == DRM_FORMAT_XRGB2101010 || fourcc == DRM_FORMAT_ARGB2101010;
+        break;
+    case AV_PIX_FMT_X2BGR10:
+        compatible = fourcc == DRM_FORMAT_XBGR2101010 || fourcc == DRM_FORMAT_ABGR2101010;
