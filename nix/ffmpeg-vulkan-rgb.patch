+static int vulkan_encode_check_rgb_input(AVCodecContext *avctx, FFVulkanEncodeContext *ctx)
+{
+    FFVulkanContext *s = &ctx->s;
+    VkPhysicalDeviceVideoFormatInfoKHR info = {
+        .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VIDEO_FORMAT_INFO_KHR,
+        .pNext = &ctx->profile_list,
+        .imageUsage = VK_IMAGE_USAGE_VIDEO_ENCODE_SRC_BIT_KHR,
+    };
+    VkVideoFormatPropertiesKHR *properties;
+    uint32_t count = 0;
+    int found = 0;
+    switch (s->frames->sw_format) {
+    case AV_PIX_FMT_BGRA:
+    case AV_PIX_FMT_BGR0:
+        ctx->input_format = VK_FORMAT_B8G8R8A8_UNORM;
+        break;
+    case AV_PIX_FMT_RGBA:
+    case AV_PIX_FMT_RGB0:
+        ctx->input_format = VK_FORMAT_R8G8B8A8_UNORM;
+        break;
+    case AV_PIX_FMT_X2RGB10:
+        ctx->input_format = VK_FORMAT_A2R10G10B10_UNORM_PACK32;
+        break;
+    case AV_PIX_FMT_X2BGR10:
+        ctx->input_format = VK_FORMAT_A2B10G10R10_UNORM_PACK32;
+        break;
+    default:
+        return AVERROR(ENOSYS);
+    }
+    /* Shader-oriented BGRA frames use RGBA storage. Encoding needs a native
+     * BGRA view; never interpret canonical storage as the declared colors. */
+    if (ctx->input_format != s->hwfc->format[0] &&
+        !(s->hwfc->img_flags & VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT))
+        return AVERROR(EINVAL);
+    VkResult ret = s->vkfn.GetPhysicalDeviceVideoFormatPropertiesKHR(s->hwctx->phys_dev, &info, &count, NULL);
+    if (ret != VK_SUCCESS || !count)
+        return AVERROR(ENOSYS);
+    properties = av_calloc(count, sizeof(*properties));
+    if (!properties)
+        return AVERROR(ENOMEM);
+    for (uint32_t i = 0; i < count; i++)
+        properties[i].sType = VK_STRUCTURE_TYPE_VIDEO_FORMAT_PROPERTIES_KHR;
+    ret = s->vkfn.GetPhysicalDeviceVideoFormatPropertiesKHR(s->hwctx->phys_dev, &info, &count, properties);
+    if (ret == VK_SUCCESS) {
+        for (uint32_t i = 0; i < count; i++)
+            found |= properties[i].format == ctx->input_format &&
+                     properties[i].imageTiling == s->hwfc->tiling &&
+                     properties[i].imageType == VK_IMAGE_TYPE_2D;
+    }
+    av_free(properties);
+    if (!found)
+        av_log(avctx, AV_LOG_ERROR, "RGB image format/tiling does not support this encode profile\n");
+    return found ? 0 : AVERROR(ENOSYS);
+}
