+static VkResult vulkan_encode_fd_wait(int fd, int timeout)
+{
+    struct pollfd pollfd = { .fd = fd, .events = POLLIN };
+    int ret;
+    if (fd == -1)
+        return VK_SUCCESS;
+    do {
+        ret = poll(&pollfd, 1, timeout);
+    } while (ret < 0 && errno == EINTR);
+    if (!ret)
+        return VK_NOT_READY;
+    if (ret < 0 || (pollfd.revents & (POLLERR | POLLNVAL)))
+        return VK_ERROR_DEVICE_LOST;
+    struct sync_file_info info = { 0 };
+    if (ioctl(fd, SYNC_IOC_FILE_INFO, &info) < 0 || info.status < 0)
+        return VK_ERROR_DEVICE_LOST;
+    return info.status ? VK_SUCCESS : VK_NOT_READY;
+}
+
+static VkResult vulkan_encode_event_wait(FFVkExecContext *exec)
+{
+    FFVulkanEncodeContext *ctx = (void *)((uint8_t *)exec->parent - offsetof(FFVulkanEncodeContext, enc_pool));
+    int fd = ctx->event_fds[exec->idx];
+    if (fd == -2)
+        return ctx->s.vkfn.WaitForFences(ctx->s.hwctx->act_dev, 1, &exec->fence, VK_TRUE, UINT64_MAX);
+    return vulkan_encode_fd_wait(fd, -1);
+}
