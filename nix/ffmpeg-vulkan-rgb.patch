+static int vulkan_frame_execution(AVHWFramesContext *hwfc,
+                                  enum VulkanFrameExecution kind,
+                                  FFVkExecPool **result)
+{
+    VulkanFramesPriv *fp = hwfc->hwctx;
+    VulkanDevicePriv *p = hwfc->device_ctx->hwctx;
+    FFVkExecPool *pool = atomic_load_explicit(&fp->execution[kind], memory_order_acquire);
+    int err = 0;
+
+    if (pool) {
+        *result = pool;
+        return 0;
+    }
+    err = pthread_mutex_lock(&fp->execution_mutex);
+    if (err)
+        return AVERROR(err);
+    pool = atomic_load_explicit(&fp->execution[kind], memory_order_relaxed);
+    if (!pool) {
+        AVVulkanDeviceQueueFamily *qf = kind == FRAME_COMPUTE ? p->compute_qf : p->transfer_qf;
+        if (!qf) {
+            err = AVERROR(ENOSYS);
+            goto unlock;
+        }
+        pool = av_mallocz(sizeof(*pool));
+        if (!pool) {
+            err = AVERROR(ENOMEM);
+        } else {
+            err = ff_vk_exec_pool_init(&p->vkctx, qf, pool,
+                                        qf->num * (kind == FRAME_COMPUTE ? 1 : 2),
+                                        0, 0, 0, NULL);
+            if (err < 0) {
+                /* init already destroys its partial Vulkan resources. No
+                 * pointer is published; a later allocation can retry. */
+                av_freep(&pool);
+            } else {
+                atomic_store_explicit(&fp->execution[kind], pool, memory_order_release);
+            }
+        }
+    }
+unlock:
+    pthread_mutex_unlock(&fp->execution_mutex);
+    *result = pool;
+    return err;
+}
 
