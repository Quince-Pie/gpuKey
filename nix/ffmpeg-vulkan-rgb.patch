+static void vulkan_encode_retire_input(FFVulkanEncodeContext *ctx, FFHWBaseEncodePicture *base_pic)
+{
+    FFVulkanEncodePicture *vp = base_pic->priv;
+    ff_vk_exec_discard_deps(&ctx->s, vp->exec);
+    if (vp->in.view) {
+        ctx->s.vkfn.DestroyImageView(ctx->s.hwctx->act_dev, vp->in.view, ctx->s.hwctx->alloc);
+        vp->in.view = VK_NULL_HANDLE;
+    }
+    av_frame_free(&base_pic->input_image);
+    base_pic->encode_complete = 1;
+}
+
+static int vulkan_encode_ready(AVCodecContext *avctx, FFHWBaseEncodePicture *base_pic)
+{
+    FFVulkanEncodeContext *ctx = avctx->priv_data;
+    FFVulkanEncodePicture *vp = base_pic->priv;
+    VkResult result;
+    ctx->base.async_fd = ctx->async_events ? ctx->event_fds[vp->exec->idx] : -1;
+    if (base_pic->encode_complete)
