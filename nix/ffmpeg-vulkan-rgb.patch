+static int vulkan_queue_dpb_slot(AVCodecContext *avctx, FFHWBaseEncodePicture *pic, int *initial)
+{
+    FFVulkanEncodeContext *ctx = avctx->priv_data;
+    FFVulkanEncodePicture *vp = pic->priv;
+    int chosen = -1;
+    for (int slot = 0; slot < FF_ARRAY_ELEMS(ctx->queue_dpb_views); slot++) {
+        FFHWBaseEncodePicture *old = ctx->slots[slot];
+        int needed = 0;
+        if (old) {
+            for (int list = 0; list < MAX_REFERENCE_LIST_NUM; list++)
+                for (int j = 0; j < pic->nb_refs[list]; j++)
+                    needed |= pic->refs[list][j] == old;
+            /* Non-IDR I pictures can keep a past picture for a later P picture. */
+            for (int j = 0; j < ctx->base.nb_next_prev; j++)
+                needed |= ctx->base.next_prev[j] == old && old != pic;
+        }
+        if (!needed) {
+            if (old)
+                ((FFVulkanEncodePicture *)old->priv)->dpb_slot.slotIndex = -1;
+            ctx->slots[slot] = NULL;
+            if (chosen < 0)
+                chosen = slot;
+        }
+    }
+    if (chosen < 0)
+        return AVERROR_BUG;
+    if (!ctx->queue_dpb_frames[chosen]) {
+        AVFrame *frame = av_frame_alloc();
+        if (!frame)
+            return AVERROR(ENOMEM);
+        int err = av_hwframe_get_buffer(ctx->queue_dpb_context, frame, 0);
+        if (err < 0) {
+            av_frame_free(&frame);
+            return err;
+        }
+        ctx->queue_dpb_frames[chosen] = frame;
+        err = ff_vk_create_view(&ctx->s, &ctx->common,
+                                 &ctx->queue_dpb_views[chosen], &vp->dpb.aspect,
+                                 (AVVkFrame *)frame->data[0], ctx->pic_format,
+                                 VK_IMAGE_USAGE_VIDEO_ENCODE_DPB_BIT_KHR);
+        if (err < 0)
+            return err;
+        *initial = 1;
+    }
+    vp->dpb.view = ctx->queue_dpb_views[chosen];
+    vp->dpb.aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+    ctx->slots[chosen] = pic;
+    return chosen;
+}
