+/* A failed optional cache allocation keeps exact linear/collision fallback.
+ * Count buffers, not a benchmark-derived resource limit; large lists retain
+ * the original capped hint policy and may exceed the encoded hint index. */
+static void amdgpu_grow_buffer_hash(struct amdgpu_cs_context *csc)
+{
+   const unsigned failed = 1u << 31;
+   unsigned mask = csc->buffer_hash_mask & (BUFFER_HASHLIST_SIZE - 1);
+   if ((csc->buffer_hash_mask & failed) || mask == BUFFER_HASHLIST_SIZE - 1)
+      return;
+
+   size_t count = 0;
+   for (unsigned kind = 0; kind < NUM_BO_LIST_TYPES; ++kind)
+      count += csc->buffer_lists[kind].num_buffers;
+   if (count <= 8 || (csc->buffer_indices_hashlist && count <= (mask + 1) / 4))
+      return;
+
+   unsigned capacity = csc->buffer_indices_hashlist ? mask + 1 : 32;
+   while (capacity < BUFFER_HASHLIST_SIZE && count > capacity / 4)
+      capacity *= 2;
+   int16_t *table = (int16_t *)REALLOC(csc->buffer_indices_hashlist,
+                                     csc->buffer_indices_hashlist ? (mask + 1) * sizeof(*table) : 0,
+                                     capacity * sizeof(*table));
+   if (!table) {
+      csc->buffer_hash_mask |= failed;
+      return;
+   }
+   memset(table, -1, capacity * sizeof(*table));
+   csc->buffer_indices_hashlist = table;
+   csc->buffer_hash_mask = capacity - 1;
+   /* Rebuild from live, owned lists. Clearing a resized table alone would
+    * otherwise make previously inserted buffers appear absent. */
+   for (unsigned kind = 0; kind < NUM_BO_LIST_TYPES; ++kind) {
+      struct amdgpu_buffer_list *list = &csc->buffer_lists[kind];
+      for (unsigned i = 0; i < list->num_buffers; ++i)
+         table[list->buffers[i].bo->unique_id & (capacity - 1)] = i & 0x7fff;
+   }
+}
