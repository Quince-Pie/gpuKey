+static uint32_t amdgpu_buffer_map_hash(uint32_t id)
+{
+   id ^= id >> 16;
+   id *= 0x7feb352du;
+   id ^= id >> 15;
+   id *= 0x846ca68bu;
+   return id ^ (id >> 16);
+}
+
+static void amdgpu_buffer_map_insert(struct amdgpu_buffer_list *list, unsigned index)
+{
+   size_t mask = list->map_capacity - 1;
+   struct amdgpu_winsys_bo *bo = list->buffers[index].bo;
+   size_t slot = amdgpu_buffer_map_hash(bo->unique_id) & mask;
+   while (list->buffer_map[slot] &&
+          list->buffers[list->buffer_map[slot] - 1].bo != bo)
+      slot = (slot + 1) & mask;
+   list->buffer_map[slot] = index + 1;
+}
+
+static void amdgpu_update_buffer_map(struct amdgpu_buffer_list *list, unsigned index)
+{
+   const size_t failed = (size_t)1 << (sizeof(size_t) * 8 - 1);
+   if (list->map_capacity & failed)
+      return;
+   size_t capacity = list->map_capacity;
+   if (list->num_buffers <= 8 && !list->buffer_map)
+      return;
+   if (!capacity || list->num_buffers > capacity - capacity / 4) {
+      size_t next = capacity ? capacity : 16;
+      while (list->num_buffers > next - next / 4) {
+         if (next > SIZE_MAX / (2 * sizeof(*list->buffer_map))) {
+            list->map_capacity |= failed;
+            return;
+         }
+         next *= 2;
+      }
+      uint32_t *map = (uint32_t *)REALLOC(list->buffer_map,
+                                         capacity * sizeof(*map), next * sizeof(*map));
+      if (!map) {
+         list->map_capacity |= failed;
+         return;
+      }
+      memset(map, 0, next * sizeof(*map));
+      list->buffer_map = map;
+      list->map_capacity = next;
+      for (unsigned i = 0; i < list->num_buffers; ++i)
+         amdgpu_buffer_map_insert(list, i);
+   } else {
+      amdgpu_buffer_map_insert(list, index);
+   }
+}
