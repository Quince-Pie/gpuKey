+   /* Publish the shared graphics ring once, before any graphics context can
+    * read it. Compute queues neither need the allocation nor reference it.
+    * Every graphics context takes this lock during initialization, so later
+    * immutable reads need no additional per-draw synchronization. */
+   if (sctx->is_gfx_queue && sscreen->info.gfx_level >= GFX11) {
+      simple_mtx_lock(&sscreen->tess_ring_lock);
+      if (!sscreen->attribute_pos_prim_ring) {
+         sscreen->attribute_pos_prim_ring =
+            si_aligned_buffer_create(&sscreen->b,
+                                     PIPE_RESOURCE_FLAG_UNMAPPABLE |
+                                     SI_RESOURCE_FLAG_32BIT |
+                                     SI_RESOURCE_FLAG_DRIVER_INTERNAL |
+                                     SI_RESOURCE_FLAG_DISCARDABLE,
+                                     PIPE_USAGE_DEFAULT,
+                                     sscreen->info.total_attribute_pos_prim_ring_size,
+                                     2 * 1024 * 1024);
+      }
+      bool ready = sscreen->attribute_pos_prim_ring != NULL;
+      simple_mtx_unlock(&sscreen->tess_ring_lock);
+      if (!ready) {
+         mesa_loge("can't allocate the graphics attribute ring");
+         return false;
+      }
+   }
 
