+/* Preserve rgb_yuv's four chroma samples and accumulation order. One invocation
+ * writes a 2x2 luma tile and its chroma pair; eligibility excludes blending,
+ * primaries/transfer changes, crop, scaling, rotation and interlacing. */
+static void *create_rgb_yuv_pair_shader(struct vl_compositor *c)
+{
+   struct cs_shader s = {.name = "rgb_yuv_pair", .num_samplers = 1};
+   nir_builder *b = &s.b;
+   nir_def *tile = nir_channels(b, cs_create_shader(c, &s), 0x3);
+   for (unsigned i = 0; i < 3; ++i)
+      s.params[11 + i] = s.params[i];
+   nir_def *bounds = nir_channels(b, s.params[3], 0x3);
+   nir_def *offset = nir_channels(b, s.params[3], 0xc);
+   nir_def *pixel = nir_ishl_imm(b, tile, 1);
+   nir_def *origin = nir_u2f32(b, pixel);
+   const struct glsl_type *image_type =
+      glsl_image_type(GLSL_SAMPLER_DIM_2D, false, GLSL_TYPE_FLOAT);
+   nir_variable *uv_image = nir_variable_create(b->shader, nir_var_image, image_type, "uv_image");
+   uv_image->data.binding = 1;
+   BITSET_SET(b->shader->info.images_used, 1);
+
+   nir_push_if(b, nir_ball(b, nir_flt(b, origin, bounds)));
+   for (unsigned y = 0; y < 2; ++y) {
+      for (unsigned x = 0; x < 2; ++x) {
+         nir_def *pos = nir_iadd(b, pixel, nir_imm_ivec2(b, x, y));
+         nir_def *coord = nir_fmin(b, nir_fadd_imm(b, nir_u2f32(b, pos), 0.5f), bounds);
+         nir_def *color = cs_fetch_texel(&s, coord, 0);
+         color = nir_vector_insert_imm(b, color, s.fone, 3);
+         cs_image_store(&s, pos, cs_color_conversion(&s, color, 0, RGB2YUV));
+      }
+   }
+   /* Unit scale makes the original chroma projection exactly 2x. Preserve its
+    * offset-before-projection arithmetic, including the upper edge clamp. */
+   nir_def *base = nir_fadd_imm(b, nir_u2f32(b, tile), 0.5f);
+   base = nir_ffma_weak_imm1(b, offset, -0.5f, base);
+   const float shifts[4][2] = {{0.25f, 0.25f}, {-0.25f, -0.25f},
+                               {-0.25f, 0.25f}, {0.25f, -0.25f}};
+   nir_def *color = NULL;
+   for (unsigned i = 0; i < 4; ++i) {
+      nir_def *coord = nir_fadd(b, base, nir_imm_vec2(b, shifts[i][0], shifts[i][1]));
+      coord = nir_fmin(b, nir_fmul_imm(b, coord, 2.0f), bounds);
+      nir_def *sample = cs_fetch_texel(&s, coord, 0);
+      color = color ? nir_fadd(b, color, sample) : sample;
+   }
+   color = nir_fmul_imm(b, color, 0.25f);
+   color = nir_vector_insert_imm(b, color, s.fone, 3);
+   nir_def *uv = nir_vec2(b, cs_color_conversion(&s, color, 1, RGB2YUV),
+                             cs_color_conversion(&s, color, 2, RGB2YUV));
+   s.image = uv_image;
+   cs_image_store(&s, tile, uv);
+   nir_pop_if(b, NULL);
+   return cs_create_shader_state(c, &s);
+}
